SECRET_KEY=change-me-to-something-random
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
FLASK_APP=wsgi.py

# --- Firebase Cloud Messaging (server / Firebase Admin SDK) ---------------
# From your Firebase service account JSON (Project Settings -> Service
# accounts -> Generate new private key). Never commit the real values, and
# never commit the downloaded JSON file itself.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM key. If your platform can't store real newlines in an
# env var, replace them with literal \n — the app normalizes both forms.
FIREBASE_PRIVATE_KEY=

# --- Firebase Cloud Messaging (browser / Web Push) ------------------------
# Public VAPID key from Firebase Console -> Project Settings -> Cloud
# Messaging -> Web configuration -> Web Push certificates. Not a secret.
FIREBASE_VAPID_PUBLIC_KEY=BCMVHss8Ms_9LLCwHRjilVQP8C9zQLq8lj-wkCNK4omfUMdtRgBzApoLYStAxzQuCI6sNxZuGaJT7Vo7t_NSHoM

# --- Firebase web app config (public, safe to expose to the browser) ------
# Defaults already match the "juw-literary-society" project baked into
# config.py — only set these if you fork the project onto your own
# Firebase project.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID_WEB=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=

